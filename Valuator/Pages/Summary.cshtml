@page
@model Valuator.Pages.SummaryModel
@{
}

@if (!Model.Rank.HasValue)
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/rank")
            .build()
        
        connection.on("RankCalculated", (rank) => {
            document.getElementById("rank").innerText = "Оценка содержания: " + rank
            connection.stop()
        })

        connection.start()
            .then(() => {
                connection.invoke("SubscribeToText", "@Model.Id")
            })
            .catch(err => console.log(err));
    </script>
}

@if (Model.Rank.HasValue)
{
    <p>Оценка содержания: @Model.Rank</p>
}
else
{
    <p id="rank">Оценка содержания ещё не завершена</p>
}
<p>Плагиат: @Model.Similarity</p>
