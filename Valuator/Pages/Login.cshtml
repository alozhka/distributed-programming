@page
@model LoginModel
@{
    ViewData["Title"] = "Вход";
}

<div class="text-center">
    <h2>Вход</h2>
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger">@Model.Error</div>
    }
    <form method="post">
        <div class="mb-2">
            <input name="login" placeholder="Логин" value="@Model.Login" required />
        </div>
        <div class="mb-2">
            <input name="password" type="password" placeholder="Пароль" required />
        </div>
        <input type="submit" value="Войти" />
    </form>
    <p class="mt-3">Нет аккаунта? <a asp-page="/Register">Зарегистрироваться</a></p>
</div>
