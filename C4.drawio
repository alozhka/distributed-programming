<mxfile host="app.diagrams.net" agent="1.0" version="26.0.0">
  <diagram name="C4 Container Diagram" id="c4-container">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- System Boundary -->
        <mxCell id="boundary" value="Valuator System" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=5 5;fillColor=none;strokeColor=#666666;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="240" y="160" width="1120" height="620" as="geometry" />
        </mxCell>

        <!-- Person: User -->
        <mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Отправляет текст&lt;br&gt;для оценки&lt;/font&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];fillColor=#08427B;fontColor=#ffffff;strokeColor=#073B6B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="370" width="130" height="140" as="geometry" />
        </mxCell>

        <!-- Container: Nginx -->
        <mxCell id="nginx" value="&lt;b&gt;Reverse Proxy&lt;/b&gt;&lt;br&gt;[Container: Nginx]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Балансировка нагрузки&lt;br&gt;между экземплярами Valuator&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="370" width="200" height="140" as="geometry" />
        </mxCell>

        <!-- Container: Valuator -->
        <mxCell id="valuator" value="&lt;b&gt;Valuator&lt;/b&gt; ×2&lt;br&gt;[Container: ASP.NET Core]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Принимает текст,&lt;br&gt;вычисляет similarity,&lt;br&gt;публикует задание&lt;br&gt;на вычисление rank&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="370" width="200" height="140" as="geometry" />
        </mxCell>

        <!-- Container: RabbitMQ -->
        <mxCell id="rabbitmq" value="&lt;b&gt;RabbitMQ&lt;/b&gt;&lt;br&gt;[Container: Message Broker]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Очередь сообщений&lt;br&gt;для асинхронного&lt;br&gt;вычисления rank&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2CFE7;fontColor=#000000;strokeColor=#6BA3D6;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="870" y="200" width="200" height="140" as="geometry" />
        </mxCell>

        <!-- Container: Redis -->
        <mxCell id="redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;[Container: Key-Value Store]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Хранение текстов,&lt;br&gt;rank и similarity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2CFE7;fontColor=#000000;strokeColor=#6BA3D6;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="870" y="570" width="200" height="140" as="geometry" />
        </mxCell>

        <!-- Container: RankCalculator -->
        <mxCell id="rankcalc" value="&lt;b&gt;RankCalculator&lt;/b&gt; ×2&lt;br&gt;[Container: .NET Console App]&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Конкурирующие потребители.&lt;br&gt;Вычисляют rank текста&lt;br&gt;и сохраняют в Redis&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1160" y="370" width="200" height="140" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <!-- User -> Nginx -->
        <mxCell id="e1" value="HTTP :8080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;strokeColor=#707070;fontColor=#707070;" edge="1" source="user" target="nginx" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Nginx -> Valuator -->
        <mxCell id="e2" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;strokeColor=#707070;fontColor=#707070;" edge="1" source="nginx" target="valuator" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Valuator -> RabbitMQ (publish) -->
        <mxCell id="e3" value="Publish id&lt;br&gt;[AMQP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;strokeColor=#707070;fontColor=#707070;" edge="1" source="valuator" target="rabbitmq" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Valuator -> Redis (read/write) -->
        <mxCell id="e4" value="Сохраняет текст,&lt;br&gt;similarity.&lt;br&gt;Читает rank&lt;br&gt;[TCP :6379]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;strokeColor=#707070;fontColor=#707070;" edge="1" source="valuator" target="redis" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- RabbitMQ -> RankCalculator (consume) -->
        <mxCell id="e5" value="Consume id&lt;br&gt;[AMQP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=11;strokeColor=#707070;fontColor=#707070;" edge="1" source="rabbitmq" target="rankcalc" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- RankCalculator -> Redis (read text, write rank) -->
        <mxCell id="e6" value="Читает текст,&lt;br&gt;сохраняет rank&lt;br&gt;[TCP :6379]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;strokeColor=#707070;fontColor=#707070;" edge="1" source="rankcalc" target="redis" parent="1">
